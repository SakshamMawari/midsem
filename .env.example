# ==============================================================================
# Supabase & Vercel Deployment Environment Variables
# ==============================================================================
#
# IMPORTANT:
# 1. Copy this file to `.env.local` for local development:
#    cp .env.example .env.local
# 2. Add these exact keys to your Vercel Project Settings under:
#    Project -> Settings -> Environment Variables
# 3. NEVER commit your actual `.env.local` or secret keys to version control.
#

# ------------------------------------------------------------------------------
# 1. Supabase Project Configuration (Required)
# ------------------------------------------------------------------------------
# Find these in your Supabase Dashboard under:
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. Supabase Server-Side Secret Key (Required for server-side uploads & migrations)
# ------------------------------------------------------------------------------
# IMPORTANT: Never prefix with NEXT_PUBLIC_. This key must NEVER be exposed to the browser.
# Find this in Supabase Dashboard -> Project Settings -> API -> Project API keys -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 3. Optional Admin Access Passcode
# ------------------------------------------------------------------------------
# Optional passcode required for administrative upload and delete actions
# Set this to a shared key among your 10 cohort members
ADMIN_ACCESS_KEY=midsem2026

# ------------------------------------------------------------------------------
# 4. Storage Bucket Name
# ------------------------------------------------------------------------------
# Default bucket name for academic documents in Supabase Storage
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=academic-pdfs

# ------------------------------------------------------------------------------
# 5. PostgreSQL & Prisma ORM Connection Strings (Supabase Pooler)
# ------------------------------------------------------------------------------
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.vxynlnjltecjwpimndjj:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.vxynlnjltecjwpimndjj:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 6. Site URL (Optional, defaults to current host)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

